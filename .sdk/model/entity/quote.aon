# Entity: quote

main: kit: entity: quote: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "source"
      req: false
      type: "`$STRING`"
    }
    {
      name: "text"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "насилие"
                kind: "query"
                name: "q"
                orig: "q"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/search/quotes"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "search"
            }
            {
              lit: "quotes"
            }
          ]
          select: {
            exist: [
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.quotes`"
          }
        }
        {
          method: "GET"
          orig: "/api/quotes"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "quotes"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.quotes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 1
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/quote/{id}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "quote"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/quote/random"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "quote"
            }
            {
              lit: "random"
            }
          ]
          select: {
            "$action": "random"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
