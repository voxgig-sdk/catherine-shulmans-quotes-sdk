# Entity: episode

main: kit: entity: episode: {

  alias: field: {}

  fields: [
    {
      name: "episodes"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "program"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "total"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "episode"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/search/episodes"
          parts: [
            "api"
            "search"
            "episodes"
          ]
          select: {
            exist: [
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.episodes`"
          }
        }
        {
          method: "GET"
          orig: "/api/episodes"
          parts: [
            "api"
            "episodes"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.episodes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "episode_id"
                orig: "episode_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "program"
                orig: "program"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/episodes/{program}/{episode_id}"
          parts: [
            "api"
            "episodes"
            "{program}"
            "{episode_id}"
          ]
          select: {
            exist: [
              "episode_id"
              "program"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "program"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/episodes/{program}"
          parts: [
            "api"
            "episodes"
            "{id}"
          ]
          rename: {
            param: {
              program: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "program"
                orig: "program"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/episodes/{program}/random"
          parts: [
            "api"
            "episodes"
            "{program}"
            "random"
          ]
          select: {
            "$action": "random"
            exist: [
              "program"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "episode"
      ]
    ]
  }



}
